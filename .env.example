# Doppel environment configuration — TEMPLATE (committed; no real values).
#
# Local dev:  cp .env.example .env   then fill in real values. `.env` is gitignored.
# Production (docker compose): create a gitignored `.env` on the VPS host (never committed) — compose
#             auto-loads it for `${VAR}` interpolation (see DEPLOY.md). Or inject real environment
#             variables (systemd EnvironmentFile, compose secrets); real env vars override `.env`.
# Never commit real secrets (gitleaks gates pushes, but keep them out entirely).

# Last.fm API key — primary cultural-recall source (track.getSimilar, read-only).
# Get one at https://www.last.fm/api/account/create  (the shared secret is NOT needed).
# Absent → the aggregator degrades gracefully to ListenBrainz-only.
LASTFM_API_KEY=

# Postgres + pgvector connection DSN (Day 5). The app defaults to the docker-compose dev
# database, so leave this unset for local dev with `docker compose up`. Set it to point at a
# different Postgres; production injects a real value.
# DATABASE_URL=postgresql://doppel:doppel@localhost:5432/doppel

# Postgres password for the production compose overlay (docker-compose.prod.yml). REQUIRED in prod —
# the overlay fails fast if it's unset, sets the postgres role's password, and passes it to the
# app/worker/migrate as DB_PASSWORD (the DB role stays `doppel`). Unused by the dev base (keeps the
# `doppel` default) and by a `uv run` loop pointed at an external Postgres via DATABASE_URL above. It
# reaches asyncpg as a discrete connection argument, never interpolated into a URL, so any value is
# safe. Generate a strong one: `openssl rand -hex 32`. Left commented so the DEPLOY.md runbook's single
# appended line is the only assignment (no duplicate key in the host .env); unset → the overlay fails fast.
# POSTGRES_PASSWORD=

# Redis DSN for the ARQ job queue + job lifecycle (Day 6, the COLD path). Defaults to the
# docker-compose Redis (started with the `worker` profile), so leave unset for local dev.
# REDIS_URL=redis://localhost:6379

# Anthropic API key — the LLM explainer (Claude) that writes per-result rationales (Day 6).
# Absent → recommendations are returned WITHOUT rationales (graceful degradation; the LLM never
# ranks). Get one at https://console.anthropic.com/. LLM_MODEL overrides the default checkpoint.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-6

# Optional runtime tuning — sane defaults live in config.py / docker-compose.yml; override per deploy
# or for Day-7 eval calibration. RESOLVE_CANDIDATE_LIMIT caps the cold-run top-N resolve/embed (75);
# JOB_TIMEOUT_S is the worker job timeout (900); WORKER_MAX_JOBS is worker concurrency (1, MB-bound).
# DOPPEL_APP_PORT is the host port the API binds to (the prod overlay binds it on 127.0.0.1 only).
# RESOLVE_CANDIDATE_LIMIT=75
# JOB_TIMEOUT_S=900
# WORKER_MAX_JOBS=1
# DOPPEL_APP_PORT=8000
